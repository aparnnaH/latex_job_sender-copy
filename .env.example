# TailorTeX Next.js app

# Optional. Use this when Tectonic is not available on PATH.
# Example macOS Homebrew path: /opt/homebrew/bin/tectonic
TECTONIC_PATH=

# API mode:
# local keeps the existing in-app TailorTeX behaviour.
# backend enables Java Spring Boot API calls through the typed client layer.
NEXT_PUBLIC_TAILORTEX_API_MODE=local
NEXT_PUBLIC_JAVA_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_JAVA_API_TIMEOUT_MS=15000
