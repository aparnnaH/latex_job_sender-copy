# TailorTeX Next.js app

# Optional. Use this when Tectonic is not available on PATH.
# Example macOS Homebrew path: /opt/homebrew/bin/tectonic
TECTONIC_PATH=

# API mode:
# local keeps the existing in-app TailorTeX behaviour.
# backend enables Java Spring Boot API calls through the typed client layer.
NEXT_PUBLIC_TAILORTEX_API_MODE=local
NEXT_PUBLIC_JAVA_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_JAVA_API_TIMEOUT_MS=15000

# Root Docker Compose local-development settings.
# Copy this file to .env and choose local-only values before running docker compose.
POSTGRES_DB=applyflow
POSTGRES_USER=applyflow_dev
POSTGRES_PASSWORD=change-this-local-postgres-password
POSTGRES_PORT=5432

RABBITMQ_USER=applyflow_dev
RABBITMQ_PASSWORD=change-this-local-rabbitmq-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

PYTHON_TAILORING_PORT=8000
DOCUMENT_SERVICE_PORT=5000
JAVA_API_PORT=8080

APPLYFLOW_DEVELOPMENT_USER_ID=development-user
DOCUMENT_DEVELOPMENT_USER_ID=development-user
APPLYFLOW_MAX_UPLOAD_BYTES=1048576
DOCUMENT_MAX_UPLOAD_BYTES=1048576

PYTHON_SERVICE_USE_MOCK=false
PYTHON_SERVICE_CONNECT_TIMEOUT_SECONDS=5
PYTHON_SERVICE_REQUEST_TIMEOUT_SECONDS=30
PYTHON_SERVICE_RETRY_ATTEMPTS=2

TECTONIC_EXECUTABLE_PATH=tectonic
TECTONIC_TIMEOUT_SECONDS=45
APPLYFLOW_DOCUMENT_SERVICE_TIMEOUT=PT60S
APPLYFLOW_DOCUMENT_SERVICE_COMPILE_PDF=true
PYTHON_TAILORING_TIMEOUT=PT60S
APPLYFLOW_TAILORING_RETRY_ATTEMPTS=3
